@startuml title Smart Campus Study Room Booking System - Domain Class Diagram

class Student {
    - studentId: String
    - name: String
    - email: String

    + viewAvailableRooms(): List<Room>
    + bookRoom(room: Room): Booking
    + viewBookings(): List<Booking>
    + cancelBooking(booking: Booking): void
}

class Room {
    - roomId: String
    - roomNumber: String
    - capacity: int
    - isAvailable: boolean

    + checkAvailability(): boolean
    + setAvailability(available: boolean): void
}

class Booking {
    - bookingId: String
    - date: Date
    - startTime: Time
    - endTime: Time
    - status: String

    + create(): void
    + cancel(): void
    + isActive(): boolean
}

